[gd_resource type="Environment" load_steps=2 format=3 uid://f2a3b4c5d6]

[sub_resource type="Sky" id="Sky_1"]
type = 2
material = ShaderMaterial {
	shader = Shader {
		code = "
shader_type sky;

uniform vec3 ground_color : source_color = vec3(0.1, 0.1, 0.15);
uniform vec3 sky_color : source_color = vec3(0.02, 0.02, 0.05);
uniform vec3 horizon_color : source_color = vec3(0.1, 0.15, 0.25);
uniform float sun_size = 0.02;
uniform vec3 sun_color : source_color = vec3(1.0, 0.9, 0.7);
uniform vec3 sun_direction = vec3(0.3, 0.8, 0.5);

void sky() {
	vec3 ray_dir = normalize(EYEDIR);
	float sun_dot = max(dot(ray_dir, normalize(sun_direction)), 0.0);
	float horizon = max(ray_dir.y, 0.0);
	
	vec3 color = mix(sky_color, horizon_color, horizon * 0.5);
	color = mix(color, ground_color, max(-ray_dir.y, 0.0));
	
	// Sol
	color += sun_color * pow(sun_dot, 128.0) * 2.0;
	
	// Estrelas simples
	vec3 star_coord = ray_dir * 1000.0;
	float stars = max(sin(star_coord.x) * sin(star_coord.y) * sin(star_coord.z), 0.0);
	stars = pow(stars, 16.0);
	color += vec3(stars) * 0.5;
	
	RADIANCE = color;
}
		"
	}
}

[resource]
background_mode = 4
background_sky = SubResource("Sky_1")
background_energy = 1.0
ambient_light_color = Color(0.15, 0.15, 0.2, 1.0)
ambient_light_energy = 0.3