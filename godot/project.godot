; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simplicity"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

PlanetMath="res://core/planet_math.gd"
ChunkLoader="res://systems/chunk_loader.gd"
GlobalMegaStructures="res://systems/global_mega_structures.gd"

[dotnet]

project/assembly_name="Simplicity"

[input]

ui_accept={
"deadzone": 0.5,
"events": [{
"button_index": 0,
"pressed": true,
"type": "MouseButton"
}, {
"keycode": 16777221,
"pressed": true,
"type": "Key"
}]
}
ui_page_up={
"deadzone": 0.5,
"events": [{
"keycode": 16777232,
"pressed": true,
"type": "Key"
}]
}
ui_page_down={
"deadzone": 0.5,
"events": [{
"keycode": 16777233,
"pressed": true,
"type": "Key"
}]
}
orbital_orbit={
"deadzone": 0.5,
"events": [{
"button_index": 2,
"pressed": true,
"type": "MouseButton"
}, {
"button_index": 3,
"pressed": true,
"type": "MouseButton"
}]
}
orbital_pan={
"deadzone": 0.5,
"events": [{
"button_index": 1,
"pressed": true,
"type": "MouseButton"
}, {
"button_index": 2,
"pressed": true,
"type": "MouseButton"
}]
}
local_move_up={
"deadzone": 0.5,
"events": [{
"keycode": 87,
"pressed": true,
"type": "Key"
}]
}
local_move_down={
"deadzone": 0.5,
"events": [{
"keycode": 83,
"pressed": true,
"type": "Key"
}]
}
local_move_left={
"deadzone": 0.5,
"events": [{
"keycode": 65,
"pressed": true,
"type": "Key"
}]
}
local_move_right={
"deadzone": 0.5,
"events": [{
"keycode": 68,
"pressed": true,
"type": "Key"
}]
}

[rendering]

rendering_environment/default_environment="res://resources/environment.tres"
